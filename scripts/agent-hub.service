# Expert Agent Hub systemd 单元（模板）
# 部署时由 scripts/deploy.sh 将 __PROJECT_DIR__ 替换为实际项目路径
[Unit]
Description=Expert Agent Hub (域名: agenthelpagent.xyz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/agent-hub.env
ExecStart=/usr/bin/python3 -u hub/hub.py
Restart=always
RestartSec=3s
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
